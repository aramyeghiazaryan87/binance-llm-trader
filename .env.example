# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитится в git (он в .gitignore).
#   cp .env.example .env

# ============ РЕЖИМ ============
# testnet — виртуальные деньги на testnet.binance.vision (старт здесь)
# demo    — Binance Demo Trading (demo-api.binance.com), тоже виртуальные деньги
# paper   — симуляция на реальных ценах, без ключей Binance и без ордеров
# live    — РЕАЛЬНЫЕ деньги (дополнительно нужен LIVE_TRADING_CONFIRM)
TRADING_MODE=testnet

# ============ КЛЮЧИ BINANCE ============
# testnet: https://testnet.binance.vision -> Log in with GitHub -> Generate HMAC_SHA256 Key
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# demo: binance.com -> Demo Trading -> API Management
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# live: только права Reading + Spot Trading, БЕЗ вывода средств, с привязкой к IP сервера
BINANCE_API_KEY=
BINANCE_API_SECRET=
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# ============ CLAUDE (Anthropic API) ============
# https://platform.claude.com -> API Keys. Поставьте в консоли лимит расходов (spend limit).
ANTHROPIC_API_KEY=
# то же самое под другим именем (используется, если ANTHROPIC_API_KEY пуст;
# в облаке Claude Code задавайте ключ только так):
# TRADER_ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-sonnet-5-5
# low = дешевле и быстрее; medium/high = дольше думает и дороже
LLM_EFFORT=low
LLM_MAX_TOKENS=4000
# жёсткий месячный лимит расходов на LLM, USD (бот считает расходы сам и не превышает его)
LLM_MONTHLY_BUDGET_USD=10
# server-side fallback: при отказе модели по политике безопасности API повторит запрос на запасной модели
LLM_FALLBACKS=true
# что делать, если LLM недоступен или бюджет исчерпан:
#   hold  — новых входов нет, открытые позиции охраняют стопы (безопаснее)
#   rules — входить по сигналам стратегии с половинным размером
LLM_FAIL_MODE=hold
# минимальная уверенность LLM для входа и для досрочного закрытия по его совету
MIN_LLM_CONFIDENCE=0.6
CLOSE_ADVICE_MIN_CONFIDENCE=0.7

# ============ TELEGRAM (необязательно) ============
# Бот: @BotFather -> /newbot. chat_id: напишите боту, затем откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и найдите "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = сообщение каждый час, false = только при сделках и в дневном отчёте
NOTIFY_EVERY_CYCLE=false
DAILY_REPORT_HOUR_UTC=18

# ============ РЫНОК ============
QUOTE_ASSET=USDT
TIMEFRAME=1h
# сколько самых ликвидных пар показывать LLM (он выбирает из них до MAX_WATCHLIST)
UNIVERSE_SIZE=15
MAX_WATCHLIST=5
MIN_QUOTE_VOLUME=20000000
# mainnet — сигналы считаются по реальным ценам Binance (рекомендуется: цены testnet часто искажены)
# exchange — по ценам той биржи, где исполняются ордера
MARKET_DATA_SOURCE=mainnet
# другой адрес для публичных рыночных данных Binance (обычно не нужен):
# MARKET_DATA_URL=https://data-api.binance.vision
# вход пропускается, если цена на testnet отличается от реальной больше чем на N%
MAX_PRICE_DEVIATION_PCT=3

# ============ БЮДЖЕТ И РИСК ============
# 0 = весь свободный USDT на счёте в момент первого запуска
BUDGET_USDT=0
PAPER_START_USDT=10000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20
MAX_OPEN_POSITIONS=4
MAX_TOTAL_EXPOSURE_PCT=80
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=15
MIN_ORDER_USDT=10
COOLDOWN_HOURS=6
MAX_HOLD_HOURS=96

# ============ СТРАТЕГИЯ ============
ATR_STOP_MULT=2.0
ATR_TRAIL_MULT=3.0
BREAKOUT_LOOKBACK=20
MIN_VOLUME_RATIO=1.2

# ============ НОВОСТИ ============
NEWS_ENABLED=true
# NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed
NEWS_MAX_ITEMS=15
NEWS_LOOKBACK_HOURS=12
FEAR_GREED_ENABLED=true

# ============ ПРОЧЕЕ ============
RISK_CHECK_INTERVAL_SECONDS=300
CYCLE_DELAY_SECONDS=90
DATA_DIR=data
LOG_LEVEL=INFO
